# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI Providers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# AI Job Match — JSearch on RapidAPI (https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch).
# Optional: the app boots without it; the Jobs page shows a "not configured"
# message until a key is present. Copy the "X-RapidAPI-Key" value here.
RAPIDAPI_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Stripe (Premium Pack — $5). Use test keys (sk_test_… / whsec_…) first.
# Webhook secret comes from the Stripe dashboard webhook endpoint pointed at
# /api/stripe/webhook. App boots fine without these; only payment routes need them.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
