# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI Providers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# AI Job Match — JSearch on RapidAPI (https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch).
# Optional: the app boots without it; the Jobs page shows a "not configured"
# message until a key is present. Copy the "X-RapidAPI-Key" value here.
RAPIDAPI_KEY=

# AI Job Match — Adzuna backup provider (https://developer.adzuna.com/).
# Optional; covers Australia + rescues JSearch timeouts. Both values are needed
# together (free tier). Register an app to get them.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Multi-model CV generation. When "true", every configured model (Claude +
# OpenAI/GPT via OPENAI_API_KEY, plus any others) generates a CV, a blind judge
# scores each 0–10, and the highest-rated one is shown; all scores are logged
# to cv_model_scores. Unset/anything-else = single-model (Claude only). Claude
# is always the guaranteed fallback. Add Grok by setting XAI_API_KEY + a
# provider in lib/cv-models/.
CV_MULTI_MODEL=

# Professional photo conversion (remove.bg). Optional; the "Make it professional"
# feature returns "not available yet" until this is set. Get a key at
# https://www.remove.bg/api
REMOVEBG_API_KEY=

# Google Gemini (image model) for the generative "suited headshot" path — used
# for office/professional roles; manual/casual roles use remove.bg instead.
# Get a key at https://aistudio.google.com/apikey . Absent = suit roles fall
# back to the remove.bg clean-background conversion.
GEMINI_API_KEY=

# Admin emails (comma-separated) allowed to open /admin and manage the comp
# (complimentary free-access) allowlist. Absent = nobody is admin.
ADMIN_EMAILS=

# Model overrides (all optional). Pin a specific model without a code change;
# unset = the sensible defaults in lib/ai/models.ts.
#   CLAUDE_MODEL   default claude-sonnet-4-6   (CV writing, tailoring, judge, job match)
#   OPENAI_MODEL   default gpt-4o              (multi-model challenger)
#   WHISPER_MODEL  default whisper-1           (voice transcription)
#   GEMINI_MODEL   default gemini-2.5-flash-image (generative headshot)
CLAUDE_MODEL=
OPENAI_MODEL=
WHISPER_MODEL=
GEMINI_MODEL=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Stripe (Premium Pack — $5). Use test keys (sk_test_… / whsec_…) first.
# Webhook secret comes from the Stripe dashboard webhook endpoint pointed at
# /api/stripe/webhook. App boots fine without these; only payment routes need them.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
